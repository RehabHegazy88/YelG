@model ChangePasswordViewModel
@{
    ViewData["Title"] = "تغيير كلمة المرور";
}
<h2 class="page-title">تغيير كلمة المرور</h2>
<p class="lead-text">كلمة المرور الجديدة لا تقل عن 8 خانات وتحتوي على رقم وحرف إنجليزي صغير. بعد التغيير تبقين مسجّلة هنا، وتنتهي جلساتك المفتوحة على الأجهزة الأخرى خلال دقيقة.</p>

@if (User.MustChangePassword())
{
    <div class="notice warn"><b>كلمة مرور مؤقتة</b><span>حسابك بكلمة مرور مؤقتة حددها الـAdmin. اختاري كلمة مرور خاصة بك للمتابعة إلى باقي الشاشات.</span></div>
}

<form class="panel" asp-action="ChangePassword" method="post" novalidate style="max-width:520px">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

    <div class="mb-3">
        <label asp-for="CurrentPassword" class="form-label fw-semibold"></label>
        <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" autofocus />
        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="NewPassword" class="form-label fw-semibold"></label>
        <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="NewPassword" class="text-danger small"></span>
    </div>
    <div class="mb-4">
        <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
    </div>
    <button type="submit" class="btn btn-primary">حفظ كلمة المرور الجديدة</button>
</form>
