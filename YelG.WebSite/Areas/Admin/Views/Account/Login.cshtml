@model LoginInput
@{
    ViewData["Title"] = "تسجيل الدخول";
    ViewData["Bare"] = true;
}
<div class="auth-card">
    <div class="auth-brand">
        <img src="~/brand/logo-color.svg" alt="YelG Advisory" width="148" height="40">
        <p>لوحة التحكم</p>
    </div>
    <h1>تسجيل الدخول</h1>
    <form method="post" asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert error" role="alert"></div>
        <input type="hidden" asp-for="ReturnUrl">
        <div class="field">
            <label class="field-label" asp-for="Email"></label>
            <input asp-for="Email" dir="ltr" class="ltr" autocomplete="username" autofocus spellcheck="false">
            <span asp-validation-for="Email" class="field-error"></span>
        </div>
        <div class="field">
            <label class="field-label" asp-for="Password"></label>
            <input asp-for="Password" dir="ltr" class="ltr" autocomplete="current-password">
            <span asp-validation-for="Password" class="field-error"></span>
        </div>
        <div class="field check">
            <input asp-for="RememberMe">
            <label asp-for="RememberMe"></label>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn primary wide">دخول</button>
        </div>
    </form>
</div>
