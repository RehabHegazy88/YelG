@using YelG.WebSite.Infrastructure.Identity
@model ChangePasswordInput
@{
    ViewData["Title"] = "تغيير كلمة المرور";
    var mustChange = User.HasClaim(c => c.Type == AdminClaims.MustChangePassword);
}
<div class="page-head">
    <div>
        <h1>تغيير كلمة المرور</h1>
        @if (mustChange)
        {
        <p class="lead">هذه كلمة مرور مؤقتة. اختر كلمة مرور جديدة للمتابعة.</p>
        }
    </div>
</div>
<section class="panel narrow">
    <form method="post" asp-action="ChangePassword" class="editor" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert error" role="alert"></div>
        <div class="field">
            <label class="field-label" asp-for="CurrentPassword"></label>
            <input asp-for="CurrentPassword" dir="ltr" class="ltr" autocomplete="current-password">
            <span asp-validation-for="CurrentPassword" class="field-error"></span>
        </div>
        <div class="field">
            <label class="field-label" asp-for="NewPassword"></label>
            <input asp-for="NewPassword" dir="ltr" class="ltr" autocomplete="new-password" aria-describedby="pwHint">
            <p class="hint" id="pwHint">١٠ أحرف على الأقل، منها رقم وحرف إنجليزي صغير.</p>
            <span asp-validation-for="NewPassword" class="field-error"></span>
        </div>
        <div class="field">
            <label class="field-label" asp-for="ConfirmPassword"></label>
            <input asp-for="ConfirmPassword" dir="ltr" class="ltr" autocomplete="new-password">
            <span asp-validation-for="ConfirmPassword" class="field-error"></span>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn primary">حفظ كلمة المرور</button>
        </div>
    </form>
</section>
