@using YelG.WebSite.Domain.Enquiries
@model EnquiryListModel
@{
    ViewData["Title"] = "طلبات الاستشارة";
    var f = Model.Filter;
    var isAdmin = User.IsInRole(AdminRoles.Admin);
    string StatusLink(EnquiryStatus? status) => "/admin/enquiries?" + (f with { Status = status }).Query();
}
<div class="page-head">
    <div>
        <h1>طلبات الاستشارة</h1>
        <p class="lead">الطلبات الواردة من نموذج الموقع. الأوقات بتوقيت القاهرة.</p>
    </div>
    @if (isAdmin && Model.Total > 0)
    {
    <div class="head-actions"><a class="btn small ghost" href="/admin/enquiries/export?@f.Query()">تصدير CSV (@Model.Total)</a></div>
    }
</div>

<section class="panel">
    <nav class="tabs" aria-label="الحالة">
        <a href="@StatusLink(null)" aria-current="@(f.Status is null ? "page" : "false")">الكل (@Model.Counts.Values.Sum())</a>
        @foreach (var status in Enum.GetValues<EnquiryStatus>())
        {
        <a href="@StatusLink(status)" aria-current="@(f.Status == status ? "page" : "false")">@EnquiryFormat.Status(status) (@Model.Counts.GetValueOrDefault(status))</a>
        }
    </nav>
    <form method="get" action="/admin/enquiries" class="filters">
        @if (f.Status is not null)
        {
        <input type="hidden" name="status" value="@f.Status">
        }
        <div class="field">
            <label class="field-label" for="fQ">بحث</label>
            <input type="search" id="fQ" name="q" value="@f.Q" placeholder="الاسم أو البريد أو الشركة">
        </div>
        <div class="field">
            <label class="field-label" for="fService">الخدمة</label>
            <select id="fService" name="service">
                <option value="">الكل</option>
                @foreach (var (value, label) in Model.Services)
                {
                <option value="@value" selected="@(value == f.Service)">@label</option>
                }
            </select>
        </div>
        <div class="field">
            <label class="field-label" for="fFrom">من</label>
            <input type="date" id="fFrom" name="from" value="@f.From?.ToString("yyyy-MM-dd")" dir="ltr">
        </div>
        <div class="field">
            <label class="field-label" for="fTo">إلى</label>
            <input type="date" id="fTo" name="to" value="@f.To?.ToString("yyyy-MM-dd")" dir="ltr">
        </div>
        <div class="filters-actions">
            <button type="submit" class="btn small">تصفية</button>
            <a class="link" href="/admin/enquiries">مسح</a>
        </div>
    </form>

    @if (Model.Items.Count == 0)
    {
    <p class="empty">لا توجد طلبات.</p>
    }
    else
    {
    <div class="table-wrap">
    <table class="rows">
        <thead><tr><th scope="col">الوقت</th><th scope="col">الاسم</th><th scope="col" class="col-extra">الشركة</th><th scope="col" class="col-extra">الخدمة</th><th scope="col">الحالة</th><th scope="col" class="col-extra">الإشعار</th></tr></thead>
        <tbody>
        @foreach (var e in Model.Items)
        {
            <tr class="@(e.Status == EnquiryStatus.New ? "is-new" : "")">
                <td dir="ltr" class="nowrap">@AdminFormat.Time(e.AddedDate)</td>
                <td class="col-name"><a href="/admin/enquiries/@e.Id" dir="auto">@e.Name</a></td>
                <td class="col-extra" dir="auto">@e.Company</td>
                <td class="col-extra">@e.ServiceLabel</td>
                <td><span class="state @EnquiryFormat.StatusClass(e.Status)">@EnquiryFormat.Status(e.Status)</span></td>
                <td class="col-extra">@(e.NotificationSentAt is not null ? "أُرسل" : e.NotificationAttempts > 0 ? "تعذّر" : "قيد الإرسال")</td>
            </tr>
        }
        </tbody>
    </table>
    </div>
    @if (Model.PageCount > 1)
    {
    <nav class="pager" aria-label="الصفحات">
        @if (Model.Page > 1) { <a href="/admin/enquiries?@f.Query(Model.Page - 1)">السابق</a> }
        <span>صفحة @Model.Page من @Model.PageCount</span>
        @if (Model.Page < Model.PageCount) { <a href="/admin/enquiries?@f.Query(Model.Page + 1)">التالي</a> }
    </nav>
    }
    }
</section>
