@inject YelG.WebSite.Infrastructure.BrandFontsPreview BrandFonts
@using YelG.WebSite.Infrastructure.Identity
@inject EditorRegistry Registry
@inject YelG.WebSite.Application.Admin.IContentStore Store
@{
    var title = ViewData["Title"] as string;
    var bare = ViewData["Bare"] as bool? == true;
    var path = Context.Request.Path.Value ?? "";
    var isAdmin = User.IsInRole(AdminRoles.Admin);
    var name = User.FindFirst(AdminClaims.DisplayName)?.Value ?? User.Identity?.Name;
    var holdAtPassword = User.HasClaim(c => c.Type == AdminClaims.MustChangePassword);
    var preview = ViewData["PreviewAnchor"] as string ?? "";
    string Current(string href, bool exact = false) =>
        (exact ? path.Equals(href, StringComparison.OrdinalIgnoreCase) : path.StartsWith(href, StringComparison.OrdinalIgnoreCase)) ? "page" : "false";
    var flash = TempData[AdminController.FlashKey] as string;
    var newEnquiries = User.Identity?.IsAuthenticated == true && !holdAtPassword
        ? await Store.CountAsync<YelG.WebSite.Domain.Enquiries.Enquiry>(e => e.Status == YelG.WebSite.Domain.Enquiries.EnquiryStatus.New)
        : 0;
    var newApplications = User.Identity?.IsAuthenticated == true && !holdAtPassword
        ? await Store.CountAsync<YelG.WebSite.Domain.Careers.JobApplication>(a => a.Status == YelG.WebSite.Domain.Careers.ApplicationStatus.New)
        : 0;
    var flashError = TempData[AdminController.FlashErrorKey] as string;
}
<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>@(string.IsNullOrEmpty(title) ? "" : title + " · ")لوحة تحكم YelG</title>
<link rel="icon" href="~/favicon.ico" sizes="48x48">
<link rel="icon" href="~/brand/mark-512.png" type="image/png" sizes="512x512">
<link rel="apple-touch-icon" href="~/brand/apple-touch-icon.png">
@if (BrandFonts.Enabled)
{
<link rel="stylesheet" href="@BrandFonts.StylesheetUrl">
}
else
{
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Alexandria:wght@300;400;500;600;700&amp;display=swap" rel="stylesheet">
}
<link rel="stylesheet" href="~/admin/admin.css" asp-append-version="true">
</head>
<body class="@(bare ? "bare" : "")">
@if (bare)
{
<main id="main" class="bare-main">
    @RenderBody()
</main>
}
else
{
<a href="#main" class="skip">تخطَّ إلى المحتوى</a>
<header class="topbar">
    <button type="button" hidden="@holdAtPassword" class="icon-btn nav-toggle" aria-controls="adminNav" aria-expanded="false" data-nav-toggle>
        <span class="sr">القائمة</span><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
    <a class="brand" href="/admin">
        <img src="~/brand/logo-white.svg" alt="YelG Advisory" width="119" height="32">
        <span class="brand-label">لوحة التحكم</span>
    </a>
    @if (!holdAtPassword)
    {
    <div class="top-preview" role="group" aria-label="معاينة الموقع">
        <span class="top-label">معاينة:</span>
        <a class="chip" href="/admin/preview/ar@(preview)" target="_blank" rel="noopener">العربية</a>
        <a class="chip" href="/admin/preview/en@(preview)" target="_blank" rel="noopener" lang="en">English</a>
    </div>
    }
    <div class="top-user">
        <span class="user-name">@name</span>
        <a class="link" href="/admin/account/password">كلمة المرور</a>
        <form method="post" action="/admin/logout" asp-antiforgery="true">
            <button type="submit" class="link">خروج</button>
        </form>
    </div>
</header>
<div class="shell">
    <nav class="sidebar" id="adminNav" aria-label="لوحة التحكم">
        @if (!holdAtPassword)
        {
        <ul>
            <li><a href="/admin" aria-current="@Current("/admin", exact: true)">الرئيسية</a></li>
            <li><a href="/admin/enquiries" aria-current="@Current("/admin/enquiries")"><span>طلبات الاستشارة</span>@if (newEnquiries > 0) {<span class="badge">@newEnquiries<span class="sr"> جديد</span></span>}</a></li>
            <li><a href="/admin/applications" aria-current="@Current("/admin/applications")"><span>طلبات التوظيف</span>@if (newApplications > 0) {<span class="badge">@newApplications<span class="sr"> جديد</span></span>}</a></li>
            <li><a href="/admin/media" aria-current="@Current("/admin/media")">مكتبة الوسائط</a></li>
        </ul>
        <p class="nav-group">أقسام الصفحة</p>
        <ul>
            @foreach (var screen in Registry.Screens.Where(s => !s.AdminOnly))
            {
            <li><a href="/admin/sections/@screen.Slug" aria-current="@Current("/admin/sections/" + screen.Slug)">@screen.Title</a></li>
            }
        </ul>
        @if (isAdmin)
        {
        <p class="nav-group">الإدارة</p>
        <ul>
            @foreach (var screen in Registry.Screens.Where(s => s.AdminOnly))
            {
            <li><a href="/admin/sections/@screen.Slug" aria-current="@Current("/admin/sections/" + screen.Slug)">@screen.Title</a></li>
            }
            <li><a href="/admin/users" aria-current="@Current("/admin/users")">المستخدمون</a></li>
            <li><a href="/admin/audit" aria-current="@Current("/admin/audit")">سجل التغييرات</a></li>
        </ul>
        }
        }
    </nav>
    <main id="main" class="content" tabindex="-1">
        @if (!string.IsNullOrEmpty(flash))
        {
        <div class="alert ok" role="status">@flash</div>
        }
        @if (!string.IsNullOrEmpty(flashError))
        {
        <div class="alert error" role="alert">@flashError</div>
        }
        @RenderBody()
    </main>
</div>
<dialog class="picker" id="mediaPicker" aria-labelledby="pickerTitle">
    <form method="dialog" class="picker-head">
        <h2 id="pickerTitle">اختيار من المكتبة</h2>
        <button type="submit" class="icon-btn" value="cancel"><span class="sr">إغلاق</span><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
    </form>
    <div class="picker-tools">
        <label class="sr" for="pickerSearch">بحث</label>
        <input type="search" id="pickerSearch" placeholder="ابحث بالاسم أو الوصف" data-picker-search>
        <label class="btn small">
            رفع ملف جديد
            <input type="file" class="sr" data-picker-upload>
        </label>
    </div>
    <p class="picker-status" role="status" data-picker-status></p>
    <div class="picker-grid" data-picker-grid></div>
    @Html.AntiForgeryToken()
</dialog>
}
<script src="~/admin/admin.js" asp-append-version="true" defer></script>
</body>
</html>
