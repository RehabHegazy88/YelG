@model HomePageModel
@{
    var c = Model.Content;
    var ind = c.Industries!;
}
<section id="industries" class="sec industries">
<div class="wrap ind-wrap">
<div class="ind-top">
<div class="head ind-head"><span class="eyebrow"><span>@Model.R(ind.Eyebrow)</span></span><h2 class="h2">@Model.Heading(ind)</h2>@if (!ind.Lead.IsEmpty){<p class="lead">@Model.R(ind.Lead)</p>}</div>
@if (c.Sectors.Count > 0)
{
<ul aria-label="@Model.S("sectorsLabel")" class="ind-sectors">
@foreach (var sector in c.Sectors){<li class="chip@(sector.IsEmphasized ? " chip-on" : "")">@Model.R(sector.Label)</li>}
</ul>
}
</div>
@if (c.ClientCategories.Count > 0)
{
<div class="ind-grid">
@foreach (var cat in c.ClientCategories)
{
<div class="ind-card">
<span aria-hidden="true" class="ind-ico ind-ico-@cat.ColorVariant">@switch (cat.IconKey)
{
    case "bank":
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 10l9-6 9 6M5 10v8M9.5 10v8M14.5 10v8M19 10v8M3 20h18"></path></svg>
        break;
    case "edu":
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M2 9l10-5 10 5-10 5z"></path><path d="M6 11v5c3 2 9 2 12 0v-5"></path></svg>
        break;
    default:
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="4" y="3" width="10" height="18" rx="1"></rect><path d="M14 9h6v12h-6M7 7h4M7 11h4M7 15h4"></path></svg>
        break;
}</span>
<span class="ind-card-text"><h3 class="h3">@Model.R(cat.Title)</h3><span>@Model.R(cat.Text)</span></span>
</div>
}
</div>
}
@if (c.ClientLogos.Count > 0)
{
@* A continuous strip: the list is written twice so the loop has no seam; the copy is hidden from
   assistive technology and the keyboard. Hover, focus or the button stop it. *@
<div class="logo-marquee" data-logo-marquee>
<div class="logo-viewport">
<div class="logo-track">
@for (var copy = 0; copy < 2; copy++)
{
var first = copy == 0;
<ul class="ind-logos" aria-label="@(first ? Model.S("clientLogosLabel") : null)" aria-hidden="@(first ? null : "true")">
@foreach (var logo in c.ClientLogos)
{
var alt = first ? Model.T(logo.Name) : "";
<li>@if (!string.IsNullOrEmpty(logo.WebsiteUrl)){<a href="@logo.WebsiteUrl" target="_blank" rel="noopener" tabindex="@(first ? null : "-1")"><img src="@logo.Logo!.Path" alt="@alt" loading="lazy" width="@logo.Logo.Width" height="@logo.Logo.Height"></a>}else{<img src="@logo.Logo!.Path" alt="@alt" loading="lazy" width="@logo.Logo.Width" height="@logo.Logo.Height">}</li>
}
</ul>
}
</div>
</div>
<button type="button" class="why-arrow why-pause logo-pause" data-logo-pause aria-label="@Model.S("logoPause")" data-label-pause="@Model.S("logoPause")" data-label-play="@Model.S("logoPlay")"><svg class="i-pause" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="5" width="4" height="14" rx="1"></rect><rect x="14" y="5" width="4" height="14" rx="1"></rect></svg><svg class="i-play" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"></path></svg></button>
</div>
}
@if (!ind.ApprovalNote.IsEmpty)
{
<p class="ind-note">@Model.R(ind.ApprovalNote)</p>
}
</div>
</section>
