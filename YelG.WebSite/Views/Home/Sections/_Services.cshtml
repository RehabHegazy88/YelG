@model HomePageModel
@{
    var c = Model.Content;
    var s = c.Services!;
    // what the detail panel needs, read by site.js (the design's SERVICES list)
    var data = c.ServiceList.Select(x => new
    {
        key = x.Key,
        icon = x.IconKey,
        cat = x.Category.Key,
        catLabel = x.Category.Name.For(Model.Lang),
        name = x.Name.For(Model.Lang),
        @long = x.LongDescription.For(Model.Lang),
        items = x.Deliverables.Select(d => d.Text.For(Model.Lang))
    });
}
<section id="services" class="sec svc-sec">
<div class="wrap svc-wrap">
<div class="sec-headrow">
<div class="head"><span class="eyebrow"><span>@Model.R(s.Eyebrow)</span></span><h2 class="h2">@Model.Heading(s)</h2>@if (!s.Lead.IsEmpty){<p class="lead">@Model.R(s.Lead)</p>}</div>
</div>
<div role="tablist" aria-label="@Model.S("serviceTabsLabel")" class="ctabs">
<button type="button" role="tab" id="cat-all" aria-selected="true" aria-controls="svcPanel" class="ctab ctab-on" data-cat="all">@Model.Data(s.AllTabLabel)<small>@c.ServiceList.Count</small></button>
@foreach (var cat in c.ServiceCategories)
{
<button type="button" role="tab" id="cat-@cat.Key" aria-selected="false" aria-controls="svcPanel" class="ctab" data-cat="@cat.Key" tabindex="-1">@Model.Data(cat.Name)<small>@c.ServiceList.Count(x => x.CategoryId == cat.Id)</small></button>
}
</div>
<div id="svcPanel" role="tabpanel" aria-labelledby="cat-all" class="svc-panel">
<div class="svc-grid">
@foreach (var svc in c.ServiceList)
{
<article class="svc" data-cat="@svc.Category.Key" data-service="@svc.Key">
<span class="ico ic-@svc.IconKey" aria-hidden="true"></span>
<span class="cat">@Model.Data(svc.Category.Name)</span>
<h3 class="h3">@Model.Data(svc.Name)</h3>
<p>@Model.Data(svc.ShortDescription)</p>
<a href="#svcDetail" class="tlink" aria-expanded="false" aria-controls="svcDetail" data-open-service="@svc.Key">@Model.T(s.CardLinkLabel)<span class="sr"> — @Model.T(svc.Name)</span> <span aria-hidden="true">@Model.ArrowNext</span></a>
</article>
}
</div>
<section id="svcDetail" class="detail" aria-labelledby="svcDetailTitle" tabindex="-1" hidden>
<button type="button" class="xbtn" aria-label="@Model.S("serviceDetailClose")" data-close-service><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M6 6l12 12M18 6 6 18"></path></svg></button>
<div class="detail-main">
<span class="ico" aria-hidden="true" data-detail="icon"></span>
<span class="detail-cat" data-detail="cat"></span>
<h3 id="svcDetailTitle" class="detail-title" data-detail="name"></h3>
<p class="detail-text" data-detail="long"></p>
<div class="detail-ctas">
<a href="#consult" class="btn btn-cyan" data-detail="discuss">@Model.T(s.DiscussCtaLabel)<span class="ar">@Model.ArrowIcon</span></a>
</div>
</div>
<div class="detail-scope">
<h4 class="detail-scope-title">@Model.R(s.ScopeHeading)</h4>
<ul class="dl" data-detail="items"></ul>
</div>
</section>
</div>
</div>
<script type="application/json" id="svcData">@Json.Serialize(data)</script>
</section>
