@using YelG.WebSite.Domain.Sections
@model TeamCardModel
@{
    // one member: photo (or initials), name, role, a short bio, certificates and LinkedIn
    var P = Model.Page;
    var m = Model.Member;
    var name = P.T(m.Name);
    var credentials = m.CredentialList();
}
<li class="tcard">
@if (m.Photo is { } photo){<span class="tcard-photo"><img src="@photo.Path" alt="" loading="lazy"></span>}else{<span class="tcard-photo is-initials">@TeamMember.Initials(name)</span>}
<span class="tcard-body">
<b class="tcard-name">@P.R(m.Name)</b>
<span class="tcard-role">@P.R(m.Role)@if (Model.Practice is { } practice){<span class="tcard-practice"> · @P.R(practice.Title)</span>}</span>
@if (!m.Bio.IsEmpty){<span class="tcard-bio">@P.R(m.Bio)</span>}
@if (credentials.Count > 0)
{
<span class="tcard-creds">@foreach (var cred in credentials){<span dir="ltr">@cred</span>}</span>
}
</span>
@if (!string.IsNullOrWhiteSpace(m.LinkedInUrl))
{
<a class="tcard-in" href="@m.LinkedInUrl" target="_blank" rel="noopener" aria-label="LinkedIn: @name"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.22 8h4.56v14H.22V8zm7.4 0h4.37v1.92h.06c.61-1.15 2.1-2.37 4.32-2.37 4.62 0 5.47 3.04 5.47 7v7.45h-4.56v-6.6c0-1.57-.03-3.6-2.2-3.6-2.2 0-2.53 1.72-2.53 3.49v6.71H7.62V8z"></path></svg></a>
}
</li>
