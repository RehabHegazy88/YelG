@model HomePageModel
@{
    var c = Model.Content;
}
<a href="#main" class="skip">@Model.S("skip")</a>

<partial name="~/Views/Home/Sections/_Hero.cshtml" model="Model" />

<main id="main">
@if (c.About is not null || c.Founder is not null) { <partial name="~/Views/Home/Sections/_About.cshtml" model="Model" /> }
@if (c.Services is not null && c.ServiceList.Count > 0) { <partial name="~/Views/Home/Sections/_Services.cshtml" model="Model" /> }
@if (c.Why is not null) { <partial name="~/Views/Home/Sections/_Why.cshtml" model="Model" /> }
@if (c.How is not null) { <partial name="~/Views/Home/Sections/_How.cshtml" model="Model" /> }
@if (c.Purpose is not null) { <partial name="~/Views/Home/Sections/_Purpose.cshtml" model="Model" /> }
@if (c.Engage is not null) { <partial name="~/Views/Home/Sections/_Engage.cshtml" model="Model" /> }
@if (c.Industries is not null) { <partial name="~/Views/Home/Sections/_Industries.cshtml" model="Model" /> }
@if (c.HasSelfCheck) { <partial name="~/Views/Home/Sections/_SelfCheck.cshtml" model="Model" /> }
@if (c.Faq is not null && c.FaqItems.Count > 0) { <partial name="~/Views/Home/Sections/_Faq.cshtml" model="Model" /> }
@if (c.Consult is not null) { <partial name="~/Views/Home/Sections/_Consult.cshtml" model="Model" /> }
@if (c.Insights is not null || c.Careers is not null || c.Portal is not null) { <partial name="~/Views/Home/Sections/_More.cshtml" model="Model" /> }
</main>

<partial name="~/Views/Home/Sections/_Footer.cshtml" model="Model" />
