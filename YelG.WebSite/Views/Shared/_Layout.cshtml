@inject YelG.WebSite.Infrastructure.BrandFontsPreview BrandFonts
@model HomePageModel
@{
    var site = Model.Content.Site;
    var title = Model.T(site.SeoTitle);
    var description = Model.T(site.SeoDescription);
    var ogImage = site.OgImage?.Path ?? Model.Content.Hero?.Image?.Path;
    var defaultLang = SiteLanguage.IsSupported(site.DefaultLanguage) ? site.DefaultLanguage : SiteLanguage.Arabic;
}
<!doctype html>
<html lang="@Model.Lang" dir="@Model.Dir">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>@title</title>
<meta name="description" content="@description">
@if (Model.IsPreview)
{
<meta name="robots" content="noindex, nofollow">
}
<link rel="canonical" href="@Model.Url(Model.Lang)">
@foreach (var lang in SiteLanguage.All)
{
<link rel="alternate" hreflang="@lang" href="@Model.Url(lang)">
}
<link rel="alternate" hreflang="x-default" href="@Model.Url(defaultLang)">
<meta property="og:type" content="website">
<meta property="og:site_name" content="YelG Advisory">
<meta property="og:title" content="@title">
<meta property="og:description" content="@description">
<meta property="og:url" content="@Model.Url(Model.Lang)">
<meta property="og:locale" content="@SiteLanguage.OgLocale(Model.Lang)">
<meta property="og:locale:alternate" content="@SiteLanguage.OgLocale(Model.OtherLang)">
@if (!string.IsNullOrEmpty(ogImage))
{
<meta property="og:image" content="@(Model.BaseUrl + ogImage)">
}
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="~/favicon.ico" sizes="48x48">
<link rel="icon" href="~/brand/mark-512.png" type="image/png" sizes="512x512">
<link rel="apple-touch-icon" href="~/brand/apple-touch-icon.png">
@if (BrandFonts.Enabled)
{
<link rel="stylesheet" href="@BrandFonts.StylesheetUrl">
}
else
{
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800&amp;family=Alexandria:wght@300;400;500;600;700&amp;display=swap" rel="stylesheet">
}
<link rel="stylesheet" href="~/css/design.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>
<body>
@if (Model.IsPreview)
{
<div class="preview-bar" dir="rtl" lang="ar" role="note">معاينة: تظهر هنا الأقسام والعناصر المخفية أيضًا. <a href="/admin">لوحة التحكم</a></div>
}
<div class="page@(Model.IsArabic ? " rtl" : "")" dir="@Model.Dir" lang="@Model.Lang">
@RenderBody()
</div>
<script src="~/js/site.js" asp-append-version="true" defer></script>
</body>
</html>
