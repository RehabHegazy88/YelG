@model ErrorViewModel
@{
    Layout = null;
}
<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>YelG Advisory</title>
<link rel="stylesheet" href="~/css/design.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>
<body>
<div class="page rtl" dir="rtl" lang="ar">
<main class="sec"><div class="wrap head">
<h1 class="h2">حدث خطأ غير متوقع</h1>
<p class="lead" lang="en" dir="ltr">Something went wrong. Please try again later.</p>
<p><a href="/" class="tlink">YelG Advisory</a></p>
@if (Model.ShowRequestId)
{
<p class="p" dir="ltr">Request ID: <code>@Model.RequestId</code></p>
}
</div></main>
</div>
</body>
</html>
