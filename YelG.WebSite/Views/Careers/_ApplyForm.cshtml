@model ApplyFormModel
@{
    // the application form: on a role's page, or the general one (a CV for future roles) on the careers page
    var P = Model.Page;
    var section = P.Content.Careers!;
    var outcome = ViewContext.TempData[YelG.WebSite.Controllers.CareersController.OutcomeKey] as string;
    var validation = P.Ui.Validation(P.Lang);
    var messages = new Dictionary<string, string>
    {
        ["name"] = validation["name"],
        ["email"] = validation["email"],
        ["phone"] = validation["phone"],
        ["linkedin"] = P.C("err.linkedin"),
        ["message"] = P.C("err.message"),
        ["cv"] = P.C("err.cv"),
        ["cvType"] = P.C("err.cvType"),
        ["cvSize"] = P.C("err.cvSize"),
        ["consent"] = P.C("err.consent")
    };
}
<form id="applyForm" class="cform job-form" method="post" action="@Model.Action" enctype="multipart/form-data" novalidate aria-labelledby="applyTitle"
      data-messages="@System.Text.Json.JsonSerializer.Serialize(messages)" data-error-summary="@P.S("formErrorSummary")" data-max-bytes="@P.MaxCvBytes">
@Html.AntiForgeryToken()
<div class="hp" aria-hidden="true"><label for="aWebsite">Website</label><input id="aWebsite" name="website" type="text" tabindex="-1" autocomplete="off"></div>
<div class="cform-head">
<h2 id="applyTitle" class="h3">@if (Model.General){@P.C("formTitleGeneral")}else{@P.Text(section.ApplyTitle, "applyTitle")}</h2>
<p class="cform-note">@P.R(P.Content.Consult?.RequiredNote, markStar: true)</p>
</div>
<div class="alert alert-err" role="alert" data-error-summary-box hidden><strong></strong></div>
<div class="fgrid@(Model.General ? "" : " job-fields")">
<div class="fld@(Model.General ? "" : " fld-full")"><label for="aName">@P.S("formName") <i>*</i></label><input id="aName" name="name" class="in" type="text" autocomplete="name" aria-invalid="false" aria-describedby="eaName" aria-required="true"><p id="eaName" class="err" hidden></p></div>
<div class="fld@(Model.General ? "" : " fld-full")"><label for="aEmail">@P.S("formEmail") <i>*</i></label><input id="aEmail" name="email" dir="@(P.IsArabic ? "ltr" : null)" class="in" type="email" autocomplete="email" aria-invalid="false" aria-describedby="eaEmail" aria-required="true"><p id="eaEmail" class="err" hidden></p></div>
<div class="fld@(Model.General ? "" : " fld-full")"><label for="aPhone">@P.S("formPhone") <span class="hint">@P.S("formOptional")</span></label><input id="aPhone" name="phone" dir="@(P.IsArabic ? "ltr" : null)" class="in" type="tel" autocomplete="tel" aria-invalid="false" aria-describedby="eaPhone"><p id="eaPhone" class="err" hidden></p></div>
<div class="fld@(Model.General ? "" : " fld-full")"><label for="aLinkedIn">@P.C("linkedIn") <span class="hint">@P.S("formOptional")</span></label><input id="aLinkedIn" name="linkedIn" dir="ltr" class="in" type="url" placeholder="@P.C("linkedInPlaceholder")" aria-invalid="false" aria-describedby="eaLinkedIn"><p id="eaLinkedIn" class="err" hidden></p></div>
<div class="fld fld-full"><label for="aCv">@P.C("cv") <i>*</i></label><input id="aCv" name="cv" class="in in-file" type="file" accept="@YelG.WebSite.Application.Careers.CvFileType.Accept" aria-invalid="false" aria-describedby="haCv eaCv" aria-required="true"><span id="haCv" class="hint">@P.C("cvHint")</span><p id="eaCv" class="err" hidden></p></div>
<div class="fld fld-full"><label for="aMsg">@P.C("coverLetter") <span class="hint">@P.S("formOptional")</span></label><textarea id="aMsg" name="message" class="in" rows="4" maxlength="3000" aria-invalid="false" aria-describedby="eaMsg"></textarea><p id="eaMsg" class="err" hidden></p></div>
<div class="fld fld-full"><label class="consent" for="aConsent"><input id="aConsent" name="consent" type="checkbox" value="true" aria-invalid="false" aria-describedby="eaConsent"><span>@P.Text(section.ApplyConsentText, "consent")</span></label><p id="eaConsent" class="err" hidden></p></div>
</div>
<div class="alert alert-ok" role="status" tabindex="-1" data-sent hidden="@(outcome != "sent")"><strong>@P.Text(section.ApplySuccessTitle, "successTitle")</strong><span>@P.Text(section.ApplySuccessText, "successText")</span></div>
<div class="alert alert-err" role="alert" tabindex="-1" data-failed hidden="@(outcome is not ("failed" or "invalid"))"><strong>@P.C("failure")</strong></div>
<button type="submit" class="btn btn-blue cform-submit">@P.C("submit")<span class="ar">@P.ArrowIcon</span></button>
</form>
