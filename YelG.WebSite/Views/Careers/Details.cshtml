@model CareersPageModel
@{
    var role = Model.Role!;
    var section = Model.Content.Careers!;
    var external = !string.IsNullOrWhiteSpace(role.ApplyUrl);
    var applyAction = $"/{Model.Lang}/careers/{role.Slug}/apply";
    var responsibilities = Model.Lines(role.Responsibilities);
    var requirements = Model.Lines(role.Requirements);
}
<partial name="_PageTop" model="Model" />

<main id="main">
<section class="sec careers-page">
<div class="wrap job-grid">
<article class="job-body" aria-labelledby="pageTitle">
@if (!role.Description.IsEmpty)
{
<h2 class="h3">@Model.C("about")</h2>
@foreach (var paragraph in Model.Lines(role.Description)){<p class="job-text">@Model.R(new YelG.WebSite.Domain.Common.LocalizedText(paragraph, paragraph))</p>}
}
@if (responsibilities.Count > 0)
{
<h2 class="h3">@Model.C("responsibilities")</h2>
<ul class="job-list">@foreach (var line in responsibilities){<li>@Model.R(new YelG.WebSite.Domain.Common.LocalizedText(line, line))</li>}</ul>
}
@if (requirements.Count > 0)
{
<h2 class="h3">@Model.C("requirements")</h2>
<ul class="job-list">@foreach (var line in requirements){<li>@Model.R(new YelG.WebSite.Domain.Common.LocalizedText(line, line))</li>}</ul>
}
@if (role.Tags.Count > 0){<p class="role-tags">@foreach (var tag in role.Tags){<span class="chip">@Model.R(tag.Label)</span>}</p>}
<p class="job-posted">@if (role.PostedOn is { } posted){<span>@Model.C("posted"): <time datetime="@posted.ToString("yyyy-MM-dd")">@Model.Date(posted)</time></span>}<a href="@Model.ListUrl" class="tlink">@Model.C("backToList") <span aria-hidden="true">@Model.ArrowNext</span></a></p>
</article>

<aside id="apply" class="job-apply" aria-labelledby="applyTitle">
@if (external)
{
<h2 id="applyTitle" class="h3">@Model.Text(section.ApplyTitle, "applyTitle")</h2>
<a href="@role.ApplyUrl" target="_blank" rel="noopener" class="btn btn-blue">@Model.C("applyExternal")<span class="ar">@Model.ArrowIcon</span></a>
}
else
{
<partial name="_ApplyForm" model="new ApplyFormModel(Model, applyAction, false)" />
}
</aside>
</div>
</section>
</main>
<script type="application/ld+json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.JobPosting(role)).Replace("</", "<\\/"))</script>

<partial name="~/Views/Home/Sections/_Footer.cshtml" model="Model" />
