@model CareersPageModel
@{
    var c = Model.Content;
    var section = c.Careers!;
    var roles = Model.ListedRoles;
    var n = 0;
    var generalAction = Model.ListUrl + "/apply";
}
<partial name="_PageTop" model="Model" />

<main id="main">
<section id="roles" class="sec careers-page" aria-labelledby="rolesTitle">
<div class="wrap">
<div class="jobs-head">
<h2 id="rolesTitle" class="h2">@Model.C("openRoles")@if (Model.OpenRoles.Count > 0){<span class="jobs-count"> (@Model.OpenRoles.Count)</span>}</h2>
@if (Model.Departments.Count > 1)
{
<nav class="ctabs" aria-label="@Model.C("department")">
<a href="@Model.ListUrl#roles" class="ctab@(string.IsNullOrEmpty(Model.Department) ? " ctab-on" : "")" aria-current="@(string.IsNullOrEmpty(Model.Department) ? "page" : null)">@Model.C("allDepartments")</a>
@foreach (var department in Model.Departments)
{
<a href="@Model.ListUrl?department=@Uri.EscapeDataString(department)#roles" class="ctab@(department == Model.Department ? " ctab-on" : "")" aria-current="@(department == Model.Department ? "page" : null)">@department</a>
}
</nav>
}
</div>

@if (roles.Count == 0)
{
<div class="jobs-empty">
<span class="jobs-empty-mark" aria-hidden="true"><img src="~/brand/mark-color.svg" alt="" width="56" height="56"></span>
<div class="jobs-empty-text">
<h3 class="h3">@Model.C("noOpeningsTitle")</h3>
<p>@Model.Text(section.NoOpeningsText, "noOpenings")</p>
</div>
<a href="#apply" class="btn btn-blue">@Model.C("sendCv")<span class="ar">@Model.ArrowIcon</span></a>
</div>
}
else
{
<ul class="jobs">
@foreach (var role in roles)
{
<li class="job-card">
<a href="@Model.RoleUrl(role)" class="job-link">
<span class="job-meta">@if (!role.Department.IsEmpty){<span>@Model.R(role.Department)</span><span aria-hidden="true">·</span>}<span>@Model.Type(role.EmploymentType)</span></span>
<strong class="job-title">@Model.R(role.Title)</strong>
@if (!role.Summary.IsEmpty){<span class="job-summary">@Model.R(role.Summary)</span>}
<span class="job-where">@Model.R(role.Location)@if (!role.Location.IsEmpty && !role.Experience.IsEmpty){<text> · </text>}@Model.R(role.Experience)</span>
@if (role.Tags.Count > 0){<span class="role-tags">@foreach (var tag in role.Tags){<span class="chip">@Model.R(tag.Label)</span>}</span>}
<span class="tlink job-more">@Model.C("viewRole") <span aria-hidden="true">@Model.ArrowNext</span></span>
</a>
</li>
}
</ul>
}
</div>
</section>

<section id="apply" class="sec consult general-apply" aria-labelledby="generalTitle">
<div class="wrap consult-wrap">
<div class="consult-panel">
<div aria-hidden="true" class="consult-glow"></div>
<div class="consult-inner">
<span class="eyebrow on-dark">@Model.C("generalEyebrow")</span>
<h2 id="generalTitle" class="h2 light">@Model.C("generalTitle")</h2>
<p class="consult-lead">@Model.C("generalText")</p>
<ol class="consult-steps">
@foreach (var step in new[] { "generalStep1", "generalStep2", "generalStep3" })
{
    n++;
<li><span aria-hidden="true" class="consult-num@(n == 1 ? " consult-num-on" : "")">@n</span><span class="consult-step">@Model.C(step)</span></li>
}
</ol>
</div>
</div>
<partial name="_ApplyForm" model="new ApplyFormModel(Model, generalAction, true)" />
</div>
</section>
</main>

<partial name="~/Views/Home/Sections/_Footer.cshtml" model="Model" />
